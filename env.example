# Cloudflare R2 credentials - mema values Cloudflare Dashboard eken ganna
# Mema file eka copy karala .env kiyala nama maru karanna, egin real values dala

R2_ACCOUNT_ID=your-account-id-here
R2_ACCESS_KEY_ID=your-access-key-id-here
R2_SECRET_ACCESS_KEY=your-secret-access-key-here
R2_BUCKET_NAME=your-bucket-name-here

# Server port eka (Render/Railway wage services auto set karanawa)
PORT=3000
